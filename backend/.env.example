# Nimbus Console configuration.
# Copy to `.env` and adjust for your Tailscale host.

# MySQL server (console metadata + SQL console target)
NIMBUS_MYSQL_HOST=127.0.0.1
NIMBUS_MYSQL_PORT=3306
NIMBUS_MYSQL_USER=clouduser
NIMBUS_MYSQL_PASSWORD=your_password
NIMBUS_MYSQL_DATABASE=cloud_db

# Session secret. Change this in production.
NIMBUS_SECRET_KEY=change-me-nimbus
NIMBUS_SESSION_TTL_HOURS=168
NIMBUS_COOKIE_SECURE=0

# Limits
NIMBUS_QUOTA_GB=100
NIMBUS_MAX_QUERY_ROWS=500
NIMBUS_MAX_UPLOAD_MB=200

# Password policy (product minimum is 4 characters)
NIMBUS_PASSWORD_MIN_LENGTH=4
NIMBUS_PASSWORD_MAX_LENGTH=128

# Login throttling: lock an identifier after N failures within the window.
NIMBUS_LOGIN_MAX_ATTEMPTS=5
NIMBUS_LOGIN_WINDOW_SECONDS=300
NIMBUS_LOGIN_LOCKOUT_SECONDS=300

# Object storage root (defaults to backend/storage)
# NIMBUS_STORAGE_DIR=/var/lib/nimbus/storage
